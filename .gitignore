# ============================================================
#  공개 포트폴리오 .gitignore
#  - 코드/설정/문서/대표 결과(assets)만 추적
#  - 데이터셋·모델 가중치·학습 산출물·미디어는 제외
# ============================================================

# ---------- 데이터셋 (라이선스상 재배포 금지 → 다운로드 스크립트만 제공) ----------
datasets/
data/VisDrone*/
data/raw/
data/yolo/
*.zip
*.tar
*.tar.gz

# ---------- 모델 가중치 / 학습 산출물 ----------
*.pt
*.pth
*.onnx
*.engine
*.trt
*.plan
runs/
weights/
checkpoints/

# ---------- 미디어 (대표 assets 폴더는 예외로 추적) ----------
*.mp4
*.avi
*.mov
*.mkv
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tif
*.tiff
*.gif

# ---------- 로그 / 캐시 ----------
*.log
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# ============================================================
#  예외: 대표 결과물(assets)은 반드시 포함
# ============================================================
!assets/
!assets/**
